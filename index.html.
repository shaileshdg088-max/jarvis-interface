<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07111f"><title>JARVIS — Personal AI</title>
<style>
:root{--c:#35d9ff;--bg:#07111f;--p:#0d1d30;--l:#1d3b54;--m:#8da9bd}*{box-sizing:border-box}body{margin:0;padding:env(safe-area-inset-top) 16px;background:radial-gradient(ellipse at 50% 18%,#12334c,transparent 48%),var(--bg);color:#e8f7ff;font-family:system-ui,Arial}.wrap{max-width:760px;margin:auto}.top{display:flex;justify-content:space-between;padding:22px 2px}.brand{font-weight:900;letter-spacing:.2em}.brand span,.eyebrow,.panel strong{color:var(--c)}.status,.panel small{font-size:10px;color:#8df6c5;letter-spacing:.12em}.hero{text-align:center;padding:25px 0 8px}.eyebrow{font-size:10px;letter-spacing:.25em}.hero h1{font-size:clamp(40px,9vw,64px);letter-spacing:.12em;font-weight:300;margin:12px 0 4px}.hero p,.hint{color:var(--m);font-size:12px}.reactor-wrap{display:grid;place-items:center;padding:28px 0}.reactor{width:min(64vw,250px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;position:relative;border:1px solid #35d9ff80;box-shadow:0 0 0 9px #35d9ff0b,0 0 32px #35d9ff25;background:radial-gradient(circle,#153d57,#07111f 72%)}.reactor:before,.reactor:after{content:"";position:absolute;inset:13px;border-radius:50%;border:1px dashed #35d9ff80;animation:spin 28s linear infinite}.reactor:after{inset:27px;animation-direction:reverse;animation-duration:18s}.core{width:42%;aspect-ratio:1;border-radius:50%;border:2px solid var(--c);background:radial-gradient(circle,#b6f8ff,#35d9ff 20%,#07111f 72%);box-shadow:0 0 28px #35d9ff99}.listening .core{animation:pulse 1.2s infinite}.microw{text-align:center}.mic,.send{border:0;border-radius:999px;background:var(--c);color:#03131b;font-weight:900;padding:15px 24px;cursor:pointer}.hint{text-align:center;margin:12px 0 24px}.panel{background:var(--p);border:1px solid var(--l);border-radius:18px;padding:18px;margin:14px 0}.panel-head{display:flex;justify-content:space-between;margin-bottom:12px}.panel strong{font-size:11px;letter-spacing:.15em}.reply{min-height:54px;font-size:14px;line-height:1.6}.commands{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.cmd{border:1px solid var(--l);background:#10243a;color:#e8f7ff;border-radius:12px;padding:13px;text-align:left;font-size:12px}.cmd b{display:block;color:var(--c);font-size:10px}.inputrow{display:flex;gap:8px}.inputrow input{min-width:0;flex:1;background:#071625;border:1px solid var(--l);border-radius:10px;padding:13px;color:#e8f7ff;font:inherit}.send{border-radius:10px;background:#142a42;color:#e7f7ff}.foot{text-align:center;color:#6f8da4;font-size:10px;line-height:1.6;padding:12px 10px 26px}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pulse{50%{transform:scale(1.12)}}@media(min-width:650px){.commands{grid-template-columns:repeat(4,1fr)}}
</style></head><body><main class="wrap"><header class="top"><div class="brand">J.A.R.V.I.S<span> / AI</span></div><div class="status">SYSTEM READY</div></header>
<section class="hero"><div class="eyebrow">PERSONAL ASSISTANT INTERFACE</div><h1>JARVIS</h1><p>JUST A RATHER VERY INTELLIGENT SYSTEM</p></section>
<div class="reactor-wrap"><div class="reactor" id="reactor"><div class="core"></div></div></div><div class="microw"><button class="mic" id="mic">TAP TO SPEAK</button></div><p class="hint" id="hint">Tap, allow microphone access, and speak.</p>
<section class="panel"><div class="panel-head"><strong>JARVIS RESPONSE</strong><small id="mode">STANDBY</small></div><div class="reply" id="reply">Good day. JARVIS is online. How may I assist you?</div></section>
<section class="panel"><div class="panel-head"><strong>QUICK COMMANDS</strong><small>TRY ONE</small></div><div class="commands"><button class="cmd" data-cmd="What time is it?"><b>◷ TIME</b>Tell me the time</button><button class="cmd" data-cmd="What is today's date?"><b>▦ DATE</b>Tell me the date</button><button class="cmd" data-cmd="Open YouTube"><b>▶ WEB</b>Open YouTube</button><button class="cmd" data-cmd="Motivate me"><b>✦ MOTIVATE</b>Motivation</button></div></section>
<section class="panel"><div class="panel-head"><strong>TYPE A COMMAND</strong><small>TEXT MODE</small></div><form class="inputrow" id="form"><input id="typed" placeholder="Type a message to JARVIS…" autocomplete="off"><button class="send">SEND</button></form></section><footer class="foot">AI replies use your secure backend. Voice recognition depends on browser support and microphone permission. No continuous “Hey JARVIS” listening.</footer></main>
<script>
const API_URL="https://jarvis-ai-backend-1-wcbd.onrender.com/api/chat";const reply=document.getElementById("reply"),hint=document.getElementById("hint"),mode=document.getElementById("mode"),mic=document.getElementById("mic"),reactor=document.getElementById("reactor");
function speak(t){if(!("speechSynthesis"in window))return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.rate=.94;u.pitch=.82;speechSynthesis.speak(u)}
async function answer(raw){const q=raw.trim();if(!q)return;reply.textContent="One moment…";mode.textContent="THINKING";try{const r=await fetch(API_URL,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({message:q})});const d=await r.json();if(!r.ok)throw Error(d.error||"Request failed");reply.textContent=d.reply||"No reply received.";mode.textContent="AI RESPONSE";speak(reply.textContent)}catch(e){reply.textContent="I couldn't reach the AI service. Check the internet and backend settings, then try again.";mode.textContent="CONNECTION ISSUE";hint.textContent="Connection issue: "+e.message}}
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;let rec=null;if(SR){rec=new SR();rec.lang="en-IN";rec.interimResults=false;rec.onstart=()=>{reactor.classList.add("listening");mic.textContent="LISTENING…";mode.textContent="LISTENING"};rec.onresult=e=>{let s=e.results[0][0].transcript;hint.textContent='Heard: "'+s+'"';answer(s)};rec.onerror=e=>hint.textContent="Voice error: "+e.error+". Try typing.";rec.onend=()=>{reactor.classList.remove("listening");mic.textContent="TAP TO SPEAK"}}
mic.onclick=()=>{if(!rec){hint.textContent="Voice input isn't supported here. Type instead.";return}try{rec.start()}catch(e){hint.textContent="Wait a moment and tap again."}};
document.querySelectorAll("[data-cmd]").forEach(b=>b.onclick=()=>answer(b.dataset.cmd));document.getElementById("form").onsubmit=e=>{e.preventDefault();let i=document.getElementById("typed");answer(i.value);i.value=""};
</script></body></html>
